# OpenRecruitOS Community Edition — environment template
# Copy to .env and adjust for your deployment:  cp .env.example .env

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# SQLite (default, zero-config — data stored in ./db/custom.db)
DATABASE_URL=file:/app/db/custom.db

# PostgreSQL (use with docker-compose.postgres.yml or your own Postgres):
#   also switch the datasource provider in prisma/schema.prisma to "postgresql"
#   (a ready-made copy lives at prisma/schema.postgres.prisma)
# DATABASE_URL=postgresql://openrecruitos:openrecruitos@db:5432/openrecruitos

# ---------------------------------------------------------------------------
# Auth — CHANGE THIS in production (used to sign session JWTs)
# Generate one with:  openssl rand -base64 32
# ---------------------------------------------------------------------------
JWT_SECRET=openrecruitos-dev-secret-change-me-in-production

# ---------------------------------------------------------------------------
# File storage (local driver)
# Directory where uploaded resumes are stored. Mounted as a Docker volume.
# ---------------------------------------------------------------------------
UPLOAD_DIR=/app/uploads

# ---------------------------------------------------------------------------
# Demo data
# Auto-seed demo jobs/candidates/applications/interviews and the demo account
# (admin@attitude360.com / admin123) whenever the database is empty:
#   false → never seed (clean production instance, first-run setup instead)
#   true  → seed when empty (any environment)
#   unset → seed when empty in development only
# Seeding is idempotent — existing data is never duplicated.
# ---------------------------------------------------------------------------
SEED_DEMO_DATA=true

# Host port for the app container (docker-compose files)
APP_PORT=3000
